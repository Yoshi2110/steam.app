<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/steam_card_bg"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgGameCover"
            android:layout_width="95dp"
            android:layout_height="115dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_placeholder_game" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/steam_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Left 4 Dead 2" />

            <TextView
                android:id="@+id/tvGameTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/steam_text_secondary"
                android:textSize="11sp"
                tools:text="Zombies • FPS • Co-op • Action" />

            <TextView
                android:id="@+id/tvGameReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/steam_review_positive"
                android:textSize="11sp"
                tools:text="Extremamente Positivas" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDiscountPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4c6b22"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textColor="#a4d007"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="-50%"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/steam_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="R$ 199,90"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvGamePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2A475E"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/steam_blue_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="R$ 32,99" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>