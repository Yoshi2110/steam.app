<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="220dp"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/steam_card_bg"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/imgGameCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_placeholder_banner"
                android:contentDescription="@null" />

            <!-- Discount Badge -->
            <TextView
                android:id="@+id/tvDiscountPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="#4c6b22"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#a4d007"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="-50%"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/steam_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Cyberpunk 2077" />

            <TextView
                android:id="@+id/tvGameReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/steam_review_positive"
                android:textSize="10sp"
                tools:text="Muito Positivas" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/steam_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="R$ 199,90"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvGamePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2A475E"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/steam_blue_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="R$ 99,95" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>